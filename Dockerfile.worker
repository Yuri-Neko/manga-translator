FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 libglib2.0-0 libgl1 fonts-dejavu-core fonts-noto-core fonts-noto-cjk curl && rm -rf /var/lib/apt/lists/*
WORKDIR /worker
COPY worker/requirements.txt .
RUN pip install --upgrade pip && pip install -r requirements.txt
COPY worker ./worker
RUN mkdir -p /data/uploads /data/results
CMD ["python", "-m", "worker.main"]
